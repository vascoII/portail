parameters:
    level: 6
    paths:
        - src
    excludePaths:
        - src/Http
        - var
        - vendor
    ignoreErrors:
        # Ignore errors in generated files
        - '#Call to an undefined method#'
        # Ignore SOAP client errors (external dependency)
        - '#Call to an undefined method SoapClient#'
    reportUnmatchedIgnoredErrors: false
