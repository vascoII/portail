# Normaliser les fins de ligne en LF pour tous les fichiers texte
* text=auto eol=lf

# Frontend React / TypeScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Backend Symfony / PHP
*.php text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf

# Autres fichiers texte
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf